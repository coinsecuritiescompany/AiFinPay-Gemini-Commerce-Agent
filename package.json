{
  "name": "aifinpay-gemini-commerce-agent",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Gemini-powered autonomous commerce agent using AiFinPay and Google Cloud.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test"
  },
  "dependencies": {
    "@aifinpay/agent": "1.8.1",
    "@circle-fin/developer-controlled-wallets": "10.8.0",
    "@google-cloud/firestore": "8.7.1",
    "@google/genai": "2.16.0",
    "fastify": "5.11.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "tsx": "4.23.11",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
