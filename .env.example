NODE_ENV=development
PORT=8080
LOG_LEVEL=info
ADMIN_TOKEN=replace-with-a-long-random-value

# Gemini on Google Cloud. Production should use Application Default Credentials.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-2.5-flash

# Optional local fallback. Do not expose this value in a browser.
GOOGLE_API_KEY=

# Firestore. Set false for the in-memory local store.
FIRESTORE_ENABLED=false
FIRESTORE_DATABASE_ID=(default)

# AiFinPay. Exactly 64 hexadecimal characters, without a 0x prefix.
AIFINPAY_AGENT_SEED_HEX=
AIFINPAY_API_BASE_URL=https://api.aifinpay.io
AIFINPAY_GATEWAY_ORIGINS=https://gateway.aifinpay.io
AIFINPAY_DAILY_BUDGET_USD=1
AIFINPAY_PER_CALL_BUDGET_USD=0.05

# Circle Developer-Controlled Wallets.
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_ID=
CIRCLE_WALLET_ADDRESS=
CIRCLE_BLOCKCHAIN=ARC-TESTNET
CIRCLE_USDC_TOKEN_ID=
CIRCLE_EXPLORER_BASE_URL=
CIRCLE_MAX_TRANSFER_USD=1
